    ws.cell(row=row_idx, column=1, value="SECUENCIA PARA CONTROLAR EL PELIGRO:").font = font_bold
    row_idx += 1
    for paso in st.session_state['secuencia']:
        ws.cell(row=row_idx, column=1, value=paso).font = font_normal
        row_idx += 1
        
    # Firma supervisor
    row_idx += 1
    ws.cell(row=row_idx, column=1, value=f"MEDIDA CORRECTIVA SUPERVISOR: {st.session_state['medida']}").font = font_bold
    ws.cell(row=row_idx+1, column=1, value=f"PLAZO DE IMPLEMENTACIÓN: {st.session_state['plazo']}").font = font_bold

    # Autoajuste de columnas
    for col in ws.columns:
        max_len = max(len(str(cell.value or '')) for cell in col)
        col_letter = openpyxl.utils.get_column_letter(col[0].column)
        ws.column_dimensions[col_letter].width = min(max(max_len + 3, 12), 40)

    # Conversión a bytes para descarga directa
    output = BytesIO()
    wb.save(output)
    excel_data = output.getvalue()
    
    st.markdown("---")
